# =====================================================================
#  CONFIGURAZIONE BOT CRIPTO — copia questo file in ".env" e compila
# =====================================================================

# ---- Telegram --------------------------------------------------------
# Crea un bot con @BotFather e incolla qui il token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here
# Il tuo chat id personale (scrivi a @userinfobot per scoprirlo).
# Solo questo utente potra' comandare il bot ed eseguire ordini.
TELEGRAM_CHAT_ID=123456789

# ---- Kraken API (necessarie SOLO per il live trading) ----------------
# Le puoi generare da: Kraken > Settings > API.
# Permessi minimi consigliati: "Query Funds", "Create & Modify Orders".
# NON servono per il Paper Trading.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---- Trading ---------------------------------------------------------
# PAPER  = simulazione con soldi finti (default, sicuro)
# LIVE   = ordini reali su Kraken (usa denaro vero!)
TRADING_MODE=PAPER

# Capitale iniziale in EUR
INITIAL_BUDGET_EUR=100

# Obiettivo di profitto mensile in EUR (usato solo per il reporting)
MONTHLY_TARGET_EUR=500

# Coppie da analizzare (separate da virgola, notazione Kraken)
TRADING_PAIRS=XBTEUR,ETHEUR,SOLEUR

# Percentuale massima del capitale da usare per ogni singolo trade (0-1)
MAX_POSITION_FRACTION=0.5

# Stop loss e take profit di default (in frazione, es. 0.05 = 5%)
DEFAULT_STOP_LOSS=0.05
DEFAULT_TAKE_PROFIT=0.10

# ---- Analisi / Scheduler --------------------------------------------
# Ogni quanti minuti eseguire il ciclo di analisi.
ANALYSIS_INTERVAL_MINUTES=60

# ---- News / Sentiment ------------------------------------------------
# Feed RSS di notizie crypto/finanza, separati da virgola.
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.investing.com/rss/news_301.rss
